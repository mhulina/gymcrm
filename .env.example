# Copy this file to .env.development / .env.production / .env.test and fill in real values.
# ./deploy.sh (and the dev.sh / dev-nginx.sh / prod.sh / test.sh wrappers) load
# ".env.${ENVIRONMENT}" automatically.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
IDENTITY_DB_NAME=identity_db
SCHEDULING_DB_NAME=scheduling_db

# --- JWT auth (shared by the whole GymCRM.Api process) ---
JWT_SECRET_KEY=changeme-base64-encoded-secret
JWT_ISSUER=GymCRM.IdentityAPI
JWT_AUDIENCE=GymCRM
JWT_EXPIRY_MINUTES=60

# --- Security / rate limiting ---
Security__MaxFailedLoginAttempts=10
Security__LockoutDurationMinutes=5
Security__AuthRateLimitPerMinute=100
Security__RegisterRateLimitPerMinute=100

# --- Ports (docker-compose.yaml / docker-compose.dev.yml) ---
API_HTTP_PORT=55080
API_HTTPS_PORT=55081
WEBAPP_PORT=3000

# --- Frontend build args (docker-compose.yaml) ---
REACT_APP_API_URL=http://localhost:55080
REACT_APP_IDENTITY_API_URL=http://localhost:55080
REACT_APP_SCHEDULING_API_URL=http://localhost:55080
REACT_APP_BILLING_API_URL=http://localhost:55080

ASPNETCORE_ENVIRONMENT=Development
